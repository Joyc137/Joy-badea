<div class="custom-banner">
  <h1 class="custom-banner__heading">{{ section.settings.heading }}</h1>
  <p class="custom-banner__subheading">{{ section.settings.subheading }}</p>
  <button class="custom-banner__cta" data-animate>
    {{ section.settings.button_text }}
  </button>
</div>

{{ 'banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading here" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subheading here" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" }
  ],
  "presets": [{ "name": "Custom Banner" }]
}
{% endschema %}