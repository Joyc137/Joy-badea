{% comment %}
  Product Grid Section
  Displays up to 6 merchant-selected products in a responsive grid.
  Clicking a product opens the shared popup (see snippets/product-popup.liquid)
  with dynamic variant selection and add-to-cart functionality.
{% endcomment %}

<div class="custom-grid">
  {% for block in section.blocks %}
    {% assign product = block.settings.product %}
    {% if product != blank %}
      <div class="custom-grid__item" data-product-handle="{{ product.handle }}" {{ block.shopify_attributes }}>
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
        >
        <h3 class="custom-grid__title">{{ product.title }}</h3>
        <p class="custom-grid__price">{{ product.price | money }}</p>
        <button class="custom-grid__quick-view" data-product-handle="{{ product.handle }}">
          Quick View
        </button>
      </div>
    {% endif %}
  {% endfor %}
</div>

{% render 'product-popup' %}

{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'popup.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Grid",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}